{
  "name": "tripling",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "migrate": "node --env-file-if-exists=.env server/migrate-cli.js",
    "test": "node --test server/test/*.test.js",
    "check": "node --check server/app.js && node --check server/index.js && node --check dist/app.js && node --check dist/auth.js && node --check server/legal.js && node --check scripts/smoke-deployment.mjs",
    "test:browser": "node scripts/check-browser.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1165.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0"
  }
}
