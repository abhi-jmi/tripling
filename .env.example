PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://tripling:local-development-only@localhost:5432/tripling
# Production uses ECS task-role access to Secrets Manager instead:
# DB_SECRET_ARN=
# DB_HOST=
# DB_NAME=tripling
# DB_SSL_CA=/app/certs/global-bundle.pem
# AWS_REGION=ap-southeast-2
# Optional exact origin if using a custom domain:
# PUBLIC_ORIGIN=https://tripling.in
# Required public operator details before production launch. No made-up defaults.
LEGAL_OPERATOR_NAME=Tripling
LEGAL_CONTACT_EMAIL=abhishek@tripling.in
LEGAL_JURISDICTION=Chandigarh, India
# APP_VERSION is set to the exact Git commit by the deployment pipeline.

# Public deployment target; this ID is not an AWS credential.
TRIPLING_AWS_ACCOUNT_ID=669991883783

# Infrastructure setting used by deployment scripts; must be allowed by the AWS plan.
TRIPLING_BACKUP_RETENTION_DAYS=1

# Optional Google OAuth web client. Keep real credentials only in an untracked .env.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AWS runtime instead reads a Secrets Manager JSON {"clientId":"...","clientSecret":"..."}:
# GOOGLE_OAUTH_SECRET_ARN=
# Bootstrap only: enables the optional billable NAT route and grants access to this secret.
# TRIPLING_GOOGLE_SECRET_ARN=
# TRIPLING_INTERNET_EGRESS=true
