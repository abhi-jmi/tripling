PORT=3000
NODE_ENV=development
# A replica set is required for transactional bookings and account changes.
# directConnection is useful only for local Docker access from the host.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=tripling-rs&directConnection=true
MONGODB_DATABASE=tripling
# AWS production reads Secrets Manager JSON {"uri":"mongodb+srv://..."} instead:
# MONGODB_SECRET_ARN=
# AWS_REGION=ap-southeast-2
# Optional custom trust store; production always verifies TLS.
# MONGODB_TLS_CA_FILE=
# PUBLIC_ORIGIN=https://tripling.in
LEGAL_OPERATOR_NAME=Tripling
LEGAL_CONTACT_EMAIL=abhishek@tripling.in
LEGAL_JURISDICTION=Chandigarh, India
TRIPLING_AWS_ACCOUNT_ID=669991883783
# Bootstrap is explicit after a verified migration; not an automatic cutover.
# TRIPLING_MONGODB_SECRET_ARN=
# TRIPLING_MONGODB_DATABASE=tripling
# TRIPLING_MONGODB_CUTOVER_APPROVED=yes
# TRIPLING_INTERNET_EGRESS=true
# Legacy RDS settings apply only while retaining the old foundation.
TRIPLING_BACKUP_RETENTION_DAYS=1
# Optional Google OAuth; real values belong only in untracked settings.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_SECRET_ARN=
# TRIPLING_GOOGLE_SECRET_ARN=
# One-time source export uses separate credentials, never runtime DATABASE_URL.
# PG_SOURCE_DATABASE_URL=
# PG_SOURCE_SECRET_ARN=
# PG_SOURCE_HOST=
# PG_SOURCE_DATABASE=tripling
# PG_SOURCE_SSL_CA=/app/certs/global-bundle.pem
# TRIPLING_WRITES_PAUSED=yes
# TRIPLING_DATA_MIGRATION_APPROVED=yes
# Optional Google Places API (New). Server-only; separate from Google sign-in.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACES_SECRET_ARN=
# TRIPLING_PLACES_SECRET_ARN=
